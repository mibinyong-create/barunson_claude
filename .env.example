# ─── Database (docker compose 의 postgres 서비스) ───────────────────────────
# docker compose up -d 로 띄운 뒤 아래 URL 그대로 사용하면 됩니다.
DATABASE_URL=postgresql://order_admin:order_admin_pw@localhost:5433/order_manager
PGPOOL_MAX=10

# ─── App ───────────────────────────────────────────────────────────────────
# 리버스 프록시/서브패스 배포 시 사용할 base path (예: /app). 비우면 루트(/)
NEXT_PUBLIC_BASE_PATH=

# 목록/통계의 "오늘" 기준일. 비우면 실제 오늘 날짜를 사용합니다.
# 원본 프로토타입과 동일한 화면을 보려면 2026-08-24 로 두세요.
NEXT_PUBLIC_TODAY=2026-08-24

# standalone 서버 실행 시 참조
PORT=3000
HOSTNAME=0.0.0.0
