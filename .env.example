# 이 프로젝트에서 실제로 사용하는 환경변수 목록입니다.
# `cp .env.example .env` 후 값을 채워 사용하세요. (.env 는 커밋 금지)

# ─── Database ──────────────────────────────────────────────────────────────
# 필수. 미설정 시 첫 DB 접근에서 명시적으로 실패합니다 (하드코딩 폴백 없음).
#
# [배포 · Docker Manager] 공유 PostgreSQL 서비스명을 사용합니다.
DATABASE_URL=postgresql://order_admin:CHANGE_ME@shared-postgres:5432/order_manager
#
# [로컬 개발] docker compose 로 띄운 컨테이너 (호스트 5433 포트로 매핑)
#   DATABASE_URL=postgresql://order_admin:CHANGE_ME@localhost:5433/order_manager
#
# [컨테이너에서 호스트 머신의 DB 로 접속할 때]
#   컨테이너 안의 localhost 는 컨테이너 자신을 가리키므로 host.docker.internal 을 씁니다.
#   DATABASE_URL=postgresql://order_admin:CHANGE_ME@host.docker.internal:5433/order_manager

# pg 커넥션 풀 최대 크기. 양의 정수만 유효하며 그 외 값은 10 으로 대체됩니다.
PGPOOL_MAX=10

# ─── 로컬 docker compose 전용 ──────────────────────────────────────────────
# docker-compose.yml 의 postgres 컨테이너가 읽습니다.
# DATABASE_URL 의 비밀번호와 같은 값을 넣으세요. 배포 환경에서는 사용하지 않습니다.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=order_admin
POSTGRES_DB=order_manager

# ─── App ───────────────────────────────────────────────────────────────────
# 리버스 프록시 서브패스 배포 시의 prefix (예: /c/barunson-order-manager).
# 비우면 루트(/) 기준입니다.
#
# 주의: NEXT_PUBLIC_ 접두사 변수는 클라이언트 번들에 "빌드 시점"에 인라인됩니다.
#       컨테이너 런타임 환경변수만 바꿔도 브라우저 동작은 바뀌지 않으므로,
#       Docker 빌드 시 `npm run build` 이전에 설정되어야 합니다.
NEXT_PUBLIC_BASE_PATH=

# 목록/통계 화면의 "오늘" 기준일 (YYYY-MM-DD). 비우면 실제 오늘 날짜를 사용합니다.
# 동봉된 샘플 데이터가 2026-08-24 기준으로 생성되므로, 샘플을 볼 때는 유지하세요.
# 실제 운영에서는 비워두는 것을 권장합니다. (위와 동일하게 빌드 시점에 인라인됨)
NEXT_PUBLIC_TODAY=2026-08-24

# ─── Runtime (Next.js standalone server.js 가 소비) ────────────────────────
PORT=3000
# 컨테이너 외부에서 접속하려면 0.0.0.0 이어야 합니다.
HOSTNAME=0.0.0.0

# ─── Scripts (선택) ────────────────────────────────────────────────────────
# npm run db:seed 로 생성할 주문 건수. 미설정 시 500.
# SEED_ORDER_COUNT=500
